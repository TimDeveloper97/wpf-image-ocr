<mah:MetroWindow x:Class="ImageOCR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImageOCR"
        mc:Ignorable="d"
        
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        WindowStartupLocation="CenterScreen"
                 
        Title="MainWindow" Height="1000" Width="1200">
    <StackPanel>
        <materialDesign:Card Padding="32" Margin="16"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Label Content="{Binding HelloWord}"/>
                <ComboBox Name="cbLanguage" SelectionChanged="cbLanguage_SelectionChanged">
                    <ComboBoxItem IsSelected="True">English</ComboBoxItem>
                    <ComboBoxItem>Vietnamese</ComboBoxItem>
                </ComboBox>
                <Label Content="{DynamicResource Wellcome}"/>
            </StackPanel>
        </materialDesign:Card>

        <Button Command="{Binding ImportImageCommand}" Content="Import Image" Margin="10,0"/>
        <Image Source="{Binding Image.Path}" Width="300" Height="200" Margin="10,0"/>
        <Button Command="{Binding OCRCommand}" Content="OCR" Margin="10,0"/>
        <Grid>
            <TextBlock Grid.Column="0" Text="{Binding Image.TextEng}" Margin="10"/>
            <!--<TextBlock Grid.Column="1" Text="{Binding Image.TextVi}" Margin="10"/>-->
        </Grid>
    </StackPanel>
</mah:MetroWindow>
